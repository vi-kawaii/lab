[
  {
    "label": "dump",
    "command": "rust-script \"$ZED_WORKTREE_ROOT/../scripts/dump_context.rs\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "paste",
    "command": "rust-script \"$ZED_WORKTREE_ROOT/../scripts/paste_unpack.rs\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "run",
    "command": "cargo run",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "commit",
    "command": "rust-script \"$ZED_WORKTREE_ROOT/../scripts/git_commit.rs\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
